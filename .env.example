# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required when DEBUG=False, e.g. https://yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional. Defaults to local SQLite. Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# local (default) or s3 (Supabase Storage / Cloudflare R2 / S3 – see README)
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Optional: only if your bucket is public / behind a CDN (host without https://). Leave empty otherwise;
# files are then served through this site and the bucket can stay private.
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# First-deploy admin account (used by build.sh; remove the password afterwards)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
